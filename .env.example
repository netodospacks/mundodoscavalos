# Arquitetura e Configurações de Ambiente — Pagamentos e Checkout Pix
# Este arquivo é um modelo de exemplo (.env.example). NÃO contém credenciais reais.
# Copie para .env.local no desenvolvimento local e configure os segredos nas variáveis de ambiente da Vercel.

# Modo de Pagamento: 'demonstration' (padrão seguro atual) ou 'bank_api' (quando a API real for integrada)
PAYMENT_MODE=demonstration

# Configuração de Ambiente do Provedor de Pagamento (ex: 'sandbox' ou 'production')
PIX_ENVIRONMENT=sandbox

# ==============================================================================
# FUTURA INTEGRAÇÃO BANCÁRIA PIX (Preenchimento posterior quando a API bancária for definida)
# ATENÇÃO: NUNCA utilize o prefixo NEXT_PUBLIC_ para chaves secretas ou certificados!
# ==============================================================================

# Identificador do Provedor (ex: gerencianet_efí, asaas, pagseguro, inter, bradesco, santander)
PIX_PROVIDER=generic_pix

# Chave Pix da empresa (chave aleatória, CNPJ ou email registrado no Banco Central)
PIX_KEY=exemplo-chave-pix-empresa@mundodoscavalos.com.br

# Credenciais de Autenticação OAuth2 / API Bancária (armazenadas com segurança na Vercel)
PIX_CLIENT_ID=seu_client_id_fornecido_pelo_banco
PIX_CLIENT_SECRET=seu_client_secret_fornecido_pelo_banco

# Certificado mTLS (se exigido pela API bancária, codificado em Base64 ou caminho do arquivo)
# PIX_CERTIFICATE_BASE64=
# PIX_CERTIFICATE_PASSWORD=

# Segredo de Assinatura para Webhooks de Notificação Instantânea de Pagamento Pix
PIX_WEBHOOK_SECRET=chave_secreta_para_validar_assinatura_do_webhook

# Tempo de Expiração da Cobrança Pix em minutos (ex: 30 minutos)
PIX_EXPIRATION_MINUTES=30

# URL Base pública da aplicação (para retorno e registro de webhooks)
NEXT_PUBLIC_APP_URL=https://mundodoscavalos.com.br
