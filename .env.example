# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE — CHECKOUT E PAGAMENTOS PIX
# ==============================================================================
# Este arquivo é um modelo (.env.example). Não contém credenciais reais.
# Copie para .env.local para testes locais ou configure diretamente na hospedagem (Vercel).

# Modo de Operação do Checkout:
# - 'demonstration': Modo seguro de homologação visual e arquitetural (padrão)
# - 'bank_api': Modo conectado à API bancária oficial (ativar somente após homologação)
PAYMENT_MODE=demonstration

# Ambiente da API do Provedor de Pagamento: 'sandbox' ou 'production'
PIX_ENVIRONMENT=sandbox

# Tempo limite de expiração da cobrança Pix em minutos (ex: 30)
PIX_EXPIRATION_MINUTES=30

# ==============================================================================
# BANCO DE DADOS E PERSISTÊNCIA DURÁVEL (SUPABASE / POSTGRESQL)
# ==============================================================================
# Quando fornecidas, os pedidos e eventos de auditoria são gravados de forma
# durável no Supabase. Se vazias, o sistema opera com repositório em memória/cache local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ==============================================================================
# FUTURA INTEGRAÇÃO BANCÁRIA PIX (Preenchimento posterior quando o banco for contratado)
# ATENÇÃO: NUNCA utilize o prefixo NEXT_PUBLIC_ para credenciais, chaves ou segredos!
# ==============================================================================

# Identificador da instituição parceira (ex: efi, asaas, inter, itau, bradesco)
PIX_PROVIDER=

# Chave Pix oficial da empresa (CNPJ, e-mail, telefone ou chave aleatória registrada no BACEN)
PIX_KEY=

# Credenciais de Autenticação bancária da aplicação
PIX_CLIENT_ID=
PIX_CLIENT_SECRET=

# Segredo criptográfico para validação da assinatura HMAC do Webhook de pagamento
PIX_WEBHOOK_SECRET=

# Certificado mTLS (se exigido pela API bancária do BACEN, em Base64 ou caminho do arquivo)
# PIX_CERTIFICATE_BASE64=
# PIX_CERTIFICATE_PASSWORD=

# ==============================================================================
# DOMÍNIO E URL DA APLICAÇÃO
# ==============================================================================
# NOTA: O domínio definitivo ainda não foi estabelecido. O checkout funciona
# integralmente com rotas relativas. Apenas defina se a API bancária exigir URL absoluta de retorno.
# NEXT_PUBLIC_APP_URL=
